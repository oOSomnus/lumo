{
  "name": "lumo",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:pdfjs": "bun scripts/fetch-pdfjs.ts",
    "dev": "bun run prepare:pdfjs && NODE_ENV=development bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "node node_modules/@playwright/test/cli.js test --config tests/e2e/playwright.config.ts",
    "build": "bun run prepare:pdfjs && bun scripts/build.ts",
    "update:pi": "bun update @earendil-works/pi-ai --latest"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "katex": "^0.16.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.3",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "pdfjs-dist": "6.3.289",
    "typescript": "^5.9.3"
  }
}
