{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumo",
  "version": "../package.json",
  "identifier": "io.github.oosomnus.lumo",
  "mainBinaryName": "lumo",
  "build": {
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Lumo",
        "width": 560,
        "height": 520,
        "minWidth": 440,
        "minHeight": 380,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Yihang Zhu",
    "copyright": "Copyright (c) 2026 Yihang Zhu",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Education",
    "shortDescription": "Local PDF and EPUB reader with page translation",
    "longDescription": "Lumo reads PDF and EPUB files and translates pages with a vision model. This launcher starts the local Lumo service and opens the reader in your browser.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["../dist/sidecar/lumo-server"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../dist/notices/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
